{
  "name": "rl-like",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser car-soccer game. Fixed-tick simulation (Rapier) separated from rendering (three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server:build": "tsc -p tsconfig.server.json && node server/build.mjs",
    "server:start": "node .server-build/index.js",
    "password:hash": "node server/password.mjs",
    "test:headless": "node qa/run-headless.mjs headless",
    "test:modes": "node qa/run-headless.mjs modes",
    "test:sessions": "node qa/run-headless.mjs sessions",
    "test:spectators": "node qa/run-headless.mjs spectators",
    "test:transport": "node qa/transport-regression.mjs",
    "test:heartbeat": "node qa/heartbeat-admission.mjs",
    "test:host-snapshots": "node qa/run-host-snapshot-scheduling.mjs",
    "test:spectator-batching": "node qa/run-spectator-batching.mjs",
    "test:lan": "npm run test:transport && npm run test:heartbeat && npm run test:host-snapshots && npm run test:spectator-batching",
    "test:retry": "node qa/run-retry.mjs",
    "test:private": "node qa/run-private.mjs",
    "test:spectator-host": "node qa/run-spectator-host.mjs",
    "test:host-startup": "node qa/run-host-startup.mjs",
    "test:spectator-admission": "node qa/run-spectator-admission.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
