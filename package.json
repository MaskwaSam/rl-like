{
  "name": "rl-like",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser car-soccer game. Fixed-tick simulation (Rapier) separated from rendering (three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server:build": "tsc -p tsconfig.server.json && node server/build.mjs",
    "server:start": "node .server-build/index.js",
    "password:hash": "node server/password.mjs",
    "test:headless": "node qa/run-headless.mjs headless",
    "test:modes": "node qa/run-headless.mjs modes",
    "test:sessions": "node qa/run-headless.mjs sessions",
    "test:spectators": "node qa/run-headless.mjs spectators",
    "test:transport": "node qa/transport-regression.mjs",
    "test:heartbeat": "node qa/heartbeat-admission.mjs",
    "test:host-snapshots": "node qa/run-host-snapshot-scheduling.mjs",
    "test:spectator-batching": "node qa/run-spectator-batching.mjs",
    "test:lan": "npm run test:transport && npm run test:heartbeat && npm run test:host-snapshots && npm run test:spectator-batching",
    "test:friction-allocation": "node qa/car-friction-runner.mjs",
    "test:spectator-scratch": "node qa/run-spectator-scratch.mjs",
    "test:pad-render": "node qa/pad-render-updates.mjs",
    "test:nameplates": "node qa/nameplate-reuse.mjs",
    "test:hotpaths": "npm run test:friction-allocation && npm run test:spectator-scratch && npm run test:pad-render && npm run test:nameplates && npm run test:ribbons",
    "test:retry": "node qa/run-retry.mjs",
    "test:private": "node qa/run-private.mjs",
    "test:server-inputs": "node qa/server-input-preflight.mjs",
    "test:server-scheduling": "node qa/run-server-authority-scheduling.mjs",
    "test:server-queues": "node qa/server-worker-queues.mjs",
    "test:server-play": "node qa/run-server-play.mjs",
    "test:server-play:4v4": "SERVER_PLAY_TEAM_SIZE=4 node qa/run-server-play.mjs",
    "test:server": "npm run test:server-inputs && npm run test:server-scheduling && npm run test:server-queues && npm run test:server-play && npm run test:server-play:4v4 && npm run test:private",
    "test:spectator-host": "node qa/run-spectator-host.mjs",
    "test:host-startup": "node qa/run-host-startup.mjs",
    "test:spectator-admission": "node qa/run-spectator-admission.mjs",
    "test:ribbons": "node qa/ribbon-reuse.mjs",
    "qa:visual": "tsc --project qa/tsconfig.visual.json && node qa/render-visual-server.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
